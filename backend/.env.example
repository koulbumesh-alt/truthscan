# Runtime
TRUTHSCAN_ENV=development
TRUTHSCAN_HOST=0.0.0.0
TRUTHSCAN_PORT=8000
TRUTHSCAN_DATABASE_PATH=backend/data/truthscan.db
TRUTHSCAN_CACHE_TTL_SECONDS=300
TRUTHSCAN_REQUEST_TIMEOUT_SECONDS=12
TRUTHSCAN_MAX_ARTICLES_PER_FEED=25

# Optional paid/commercial news providers. RSS works without these.
GNEWS_API_KEY=
NEWSAPI_KEY=

# Recommended for structured debunk results (publisher, rating, review URL).
# Enable the Google Fact Check Tools API in a Google Cloud project.
GOOGLE_FACT_CHECK_API_KEY=

# Optional but recommended for richer YouTube link verification (description,
# channel and publication time). Public YouTube oEmbed still works without it.
YOUTUBE_API_KEY=

# Recommended for actual public YouTube video analysis. When configured,
# spoken audio and sampled frames are used to extract checkable claims before
# live publisher/fact-check search. Without it, only live metadata is checked.
#
# Production (preferred): store the value in an encrypted deployment secret
# and mount it as a file. Set only the path here—not the secret itself.
GEMINI_API_KEY_FILE=
# Local fallback: environment variable read only by the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Official X API v2 Post lookup. Prefer the mounted secret-file option.
X_BEARER_TOKEN_FILE=
X_BEARER_TOKEN=

# Official Meta Graph API access. Production use requires the appropriate
# Meta App Review/business verification and permitted Page/Instagram access.
META_ACCESS_TOKEN_FILE=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
# Professional Instagram account authorized by the configured Meta token.
META_INSTAGRAM_ACCOUNT_ID=

# Account email delivery. In development, the API returns one-time action URLs
# when SMTP is absent. Production never returns these URLs, so SMTP is required.
TRUTHSCAN_APP_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_FILE=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Google OAuth 2.0 web application credentials. Register this callback:
# {TRUTHSCAN_APP_BASE_URL}/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta Login app credentials. Register this callback:
# {TRUTHSCAN_APP_BASE_URL}/api/v1/auth/oauth/meta/callback
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET_FILE=
META_OAUTH_APP_SECRET=

# Optional: if set, POST /api/v1/news/refresh requires this value
# in the X-Admin-Key header.
TRUTHSCAN_ADMIN_KEY=

# Comma-separated origins. Same-origin frontend needs no CORS entry.
TRUTHSCAN_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
