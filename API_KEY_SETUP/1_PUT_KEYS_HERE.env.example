# TRUTHSCAN API CREDENTIALS — SAFE TEMPLATE
# Copy this file to 1_PUT_KEYS_HERE.env and fill only the providers you use.
# Never commit the completed file.

# Google Gemini — spoken-audio and sampled-frame analysis for YouTube
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional richer YouTube metadata
YOUTUBE_API_KEY=

# Optional structured fact-check results
GOOGLE_FACT_CHECK_API_KEY=

# X API v2 — official live Post lookup
X_BEARER_TOKEN=

# Meta Graph API — permitted Facebook and Instagram content
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
META_INSTAGRAM_ACCOUNT_ID=

# Email verification and password recovery
TRUTHSCAN_APP_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Google social login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta social login — separate from META_ACCESS_TOKEN
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=

# Optional additional news providers
GNEWS_API_KEY=
NEWSAPI_KEY=
